# Copy to .env and fill in. .env is gitignored — real values never reach git.
#
#   cp .env.example .env && $EDITOR .env

# Exchange host, without scheme. Example: mail.example.com
EXCHANGE_HOST=mail.example.com

# Bare Exchange/NTLM username — no domain prefix, no UPN. Example: jdoe
EXCHANGE_USER=jdoe

# Full UPN used in the DavMail CalDAV path. Example: jdoe@example.com
EXCHANGE_UPN=jdoe@example.com

# Google calendar we own and write into. Get the ID from Calendar settings →
# "Integrate calendar" → Calendar ID.
GCAL_ID=your-calendar-id@group.calendar.google.com

# Sync window and cadence.
SYNC_INTERVAL=120
WINDOW_PAST_DAYS=7
WINDOW_FUTURE_DAYS=90

# LOCAL Mac only: corporate proxy on the host. On a VM with direct internet
# access set PROXY_URL= (empty) and drop the proxy args in docker-compose.yml.
PROXY_URL=http://host.docker.internal:2080
